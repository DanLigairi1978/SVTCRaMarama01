# Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env or .env.local — they contain secrets.

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ── Firebase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ── Google / Gemini AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── GitHub image storage (Stories admin photo uploads) ──────────────────────────
# Firebase Storage isn't enabled yet, so Stories photos are pushed straight to a
# dedicated public repo instead. Use a *fine-grained* GitHub personal access token
# scoped ONLY to that one repo, with Contents: Read and write permission — nothing
# else. Because this is a static site with no server, this token ships in the
# client bundle and is extractable via view-source, so keeping its scope to just
# this throwaway images repo is what limits the blast radius if it ever leaks.
NEXT_PUBLIC_GITHUB_IMAGES_REPO=DanLigairi1978/svtcblogimages
NEXT_PUBLIC_GITHUB_IMAGES_TOKEN=your-fine-grained-github-token
